---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import RevealHeading from '../../components/RevealHeading.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Button from '../../components/Button.astro';
import Enquiry from '../../components/Enquiry.astro';
import { serviceMenuGroups } from '../../data/services';
const intros=['Villa gardens, terraces and commercial landscapes.','Pergolas, paving, pools, water features and irrigation.','Planting, living walls, planters and garden maintenance.'];
---
<Layout title="All landscaping services, ANZ Landscaping" description="Explore all 15 ANZ services, from terrace and villa gardens to commercial landscaping, pools, living walls, irrigation, plant rental and garden care.">
 <section class="directory-heading section-pad"><span class="eyebrow">Landscaping services</span><RevealHeading as="h1" lines={["Our services."]}/><div><p>Design, installation and ongoing care.</p><Button href="#enquire">Talk to ANZ</Button></div></section>
 <nav class="directory-nav" aria-label="Service categories">{serviceMenuGroups.map((group,index)=><a class="choice-surface" href={`#category-${index}`}><span class="control-label">{group.title}</span></a>)}</nav>
 {serviceMenuGroups.map((group,index)=><section id={`category-${index}`} class="directory-group section-pad"><div class="directory-intro"><span class="eyebrow">Explore our services</span><RevealHeading lines={[group.title]} variant="soft"/><p>{intros[index]}</p><Image src={group.services[0].image} format="webp" widths={[400,700]} sizes="(max-width:700px) 90vw, 30vw" alt={group.title+', ANZ service photography'} loading="lazy"/></div><div class="directory-links">{group.services.map(service=><a href={`/services/${service.slug}/`}><span class="directory-service-icon"><ServiceIcon name={service.icon} size={30}/></span><h3>{service.title}</h3><p>{service.description}</p><span class="directory-card-bottom"><span>Explore service</span></span></a>)}</div></section>)}
 <Enquiry/>
</Layout>
