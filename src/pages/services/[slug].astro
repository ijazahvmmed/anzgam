---
import { Picture } from 'astro:assets';
import ProjectPreparation from '../../components/ProjectPreparation.astro';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Enquiry from '../../components/Enquiry.astro';
import RevealHeading from '../../components/RevealHeading.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { allServices,serviceCategories } from '../../data/services';
export function getStaticPaths(){return allServices.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
const related=allServices.filter(s=>s.category===service.category&&s.slug!==service.slug).slice(0,3);
---
<Layout title={`${service.title}, ANZ Landscaping`} description={service.description}>
 <section class="detail-heading service-heading section-pad">
  <a class="text-link" href="/services/">All services</a>
  <div class="section-heading"><div><span class="eyebrow service-category"><ServiceIcon name={service.icon} size={24}/>{serviceCategories[service.category]}</span><RevealHeading as="h1" lines={[service.title]}/></div><p>{service.description}</p></div>
  <div class="service-heading-cta"><Button href="#enquire">Discuss your project</Button><span>Bengaluru</span></div>
 </section>
 <div class="service-detail-hero"><Picture fallbackFormat="webp" src={service.image} formats={['webp']} widths={[480,800,Math.min(service.image.width,1400)]} sizes="100vw" quality={77} alt={service.title+', ANZ Landscaping service photography'} loading="eager" fetchpriority="high"/></div>
 <section class="service-overview section-pad"><div><h2>Overview</h2></div><div><p>{service.overview}</p><a class="text-link" href="#service-scope">Explore what’s included</a></div></section>
 <section id="service-scope" class="service-inclusions section-pad"><div class="section-heading"><div><span class="eyebrow">The scope</span><RevealHeading lines={["What’s included."]}/></div></div><div class="scope-grid">{service.scope.map((scope,index)=><article class="scope-card"><ServiceIcon name={index===0?'approach':index===1?service.icon:'leaf'} size={30}/><h3>{scope.title}</h3><ul>{scope.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
 <section class="service-benefits section-pad"><span class="eyebrow">At a glance</span><div>{service.benefits.map(benefit=><div><h3>{benefit}</h3></div>)}</div></section>
 <section class="service-related section-pad"><div class="section-heading"><div><span class="eyebrow">More from ANZ</span><h2>Related services.</h2></div><a class="text-link" href="/services/">All services</a></div><div class="related-grid">{related.map(item=><a href={`/services/${item.slug}/`}><span class="related-icon"><ServiceIcon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.description}</p></a>)}</div></section>
 <ProjectPreparation service/>
 <Enquiry service={service.title}/>
</Layout>
