---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Enquiry from '../../components/Enquiry.astro';
import RevealHeading from '../../components/RevealHeading.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { allServices,serviceCategories } from '../../data/services';
export function getStaticPaths(){return allServices.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
const related=allServices.filter(s=>s.category===service.category&&s.slug!==service.slug).slice(0,3);
---
<Layout title={`${service.title}, ANZ Landscaping`} description={service.description}>
 <section class="detail-heading service-heading section-pad">
  <a class="text-link" href="/services/">← All services</a>
  <div class="section-heading"><div><span class="eyebrow service-category"><ServiceIcon name={service.icon} size={24}/>{serviceCategories[service.category]}</span><RevealHeading as="h1" lines={[service.title]}/></div><p>{service.description}</p></div>
  <div class="service-heading-cta"><Button href="#enquire">Discuss your project</Button><span>Bengaluru</span></div>
 </section>
 <div class="service-detail-hero"><Picture fallbackFormat="webp" src={service.image} formats={['webp']} widths={[480,800,Math.min(service.image.width,1400)]} sizes="100vw" quality={77} alt={service.title+', ANZ Landscaping service photography'} loading="eager" fetchpriority="high"/></div>
 <section class="service-overview section-pad"><div><h2>Overview</h2></div><div><p>{service.overview}</p><a class="text-link" href="#service-scope">Explore what’s included <span>↓</span></a></div></section>
 <section id="service-scope" class="service-inclusions section-pad"><div class="section-heading"><div><span class="eyebrow">The scope</span><RevealHeading lines={["What’s included."]}/></div></div><div class="scope-grid">{service.scope.map((scope,index)=><article class="scope-card"><span class="scope-number">0{index+1}</span><ServiceIcon name={index===0?'approach':index===1?service.icon:'leaf'} size={30}/><h3>{scope.title}</h3><ul>{scope.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
 <section class="service-benefits section-pad"><span class="eyebrow">At a glance</span><div>{service.benefits.map((benefit,index)=><div><span>0{index+1}</span><h3>{benefit}</h3><ServiceIcon name="arrow" size={24}/></div>)}</div></section>
 <section class="service-related section-pad"><div class="section-heading"><div><span class="eyebrow">More from ANZ</span><h2>Related services.</h2></div><a class="text-link" href="/services/">All services <span>↗</span></a></div><div class="related-grid">{related.map(item=><a href={`/services/${item.slug}/`}><span class="related-icon"><ServiceIcon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.description}</p><span class="related-arrow" aria-hidden="true">↗</span></a>)}</div></section>
 <section class="faq section-pad service-faq"><div class="faq-heading"><span class="eyebrow">FAQ</span><RevealHeading lines={["Your questions."]} variant="soft"/><a class="text-link" href="#enquire">Ask our team <span>↗</span></a></div><div class="faq-list"><details name="service-faq" open><summary>Can the service be tailored to my space?<span class="faq-plus" aria-hidden="true"></span></summary><p>Yes. We confirm the design and scope after reviewing your site.</p></details><details name="service-faq"><summary>How are the cost and timeline decided?<span class="faq-plus" aria-hidden="true"></span></summary><p>Size, materials and site conditions affect both. We provide an estimate before work begins.</p></details><details name="service-faq"><summary>Can I discuss ongoing care too?<span class="faq-plus" aria-hidden="true"></span></summary><p>Yes. We can include maintenance suited to your garden or installation.</p></details></div></section>
 <Enquiry service={service.title}/>
</Layout>
