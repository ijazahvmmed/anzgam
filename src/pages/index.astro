---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ProjectPreparation from '../components/ProjectPreparation.astro';
import Layout from '../layouts/Layout.astro';
import RevealHeading from '../components/RevealHeading.astro';
import Button from '../components/Button.astro';
import HomeHero from '../components/HomeHero.astro';
import ProjectSpotlight from '../components/ProjectSpotlight.astro';
import '../styles/home.css';
import Enquiry from '../components/Enquiry.astro';
import ProjectGallery from '../components/islands/ProjectGallery';
import ServiceRail from '../components/ServiceRail.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import NatureMarquee from '../components/NatureMarquee.astro';
import NatureMark from '../components/NatureMark.astro';
import Approach from '../components/Approach.astro';
import ImageComparison from '../components/ImageComparison.astro';
import { imagery, projects } from '../data/content';
import { allServices } from '../data/services';

async function photo(image: ImageMetadata, alt: string) {
 const widths=[480,800,1200,Math.min(1800,image.width)].filter((v,i,a)=>a.indexOf(v)===i&&v<=image.width);
 const images=await Promise.all(widths.map(width=>getImage({src:image,width,format:'webp',quality:90})));
 return {src:images[images.length-1].src,srcSet:images.map((v,i)=>v.src+' '+widths[i]+'w').join(', '),width:image.width,height:image.height,alt};
}
const gallery=await Promise.all(projects.map(async p=>({...p,photo:await photo(p.image,p.name+', enhanced ANZ project photography, '+p.location)})));
const statement='We design, build and care for gardens across Bengaluru.';
---
<Layout>
 <HomeHero/>
 <ClientMarquee/>
 <ProjectSpotlight/>
 <section id="about" class="intro section-pad">
  <div class="intro-label"><span class="eyebrow">ANZ Landscaping</span><span class="intro-mark" data-scroll-shape data-turn="35"><NatureMark/></span></div>
  <div class="intro-body"><h2 class="highlight-text" data-highlight aria-label={statement}>{statement.split(' ').map(word=><span class="word" aria-hidden="true">{[...word].map(character=><span class="char">{character}</span>)}{' '}</span>)}</h2><div class="intro-foot"><p>For homes, offices and commercial spaces.</p><a class="text-link" href="#process">How we work</a></div></div>
 </section>
 <section id="services" class="services services-visual section-pad">
  <div class="section-heading"><div><span class="eyebrow">What we do</span><RevealHeading lines={["Landscape design","and care."]}/></div><Button href="#enquire" light>Discuss a project</Button></div>
  <ServiceRail/>
  <details class="all-service-disclosure" data-disclosure><summary>Browse all {allServices.length} services <span aria-hidden="true">+</span></summary><ServiceIndex compact/></details>
  <NatureMarquee/>
 </section>
 <section id="projects" class="projects section-pad"><div class="section-heading"><div><span class="eyebrow">Selected projects</span><RevealHeading lines={["Our work."]}/></div></div><ProjectGallery projects={gallery} client:visible={{rootMargin:'600px'}}/>
  <div id="compare" class="project-comparison"><div class="section-heading"><div><span class="eyebrow">Photo comparison</span><RevealHeading lines={["A closer look."]}/></div><a class="text-link" href="/projects/goodearth-malhar/">GoodEarth Malhar</a></div><ImageComparison id="malhar-comparison" before={imagery.malhar} after={projects[0].image} beforeLabel="Original photo" afterLabel="Enhanced photo" alt="Planting and a timber pergola at GoodEarth Malhar"/><p class="comparison-caption">Same ANZ project. Original and enhanced photography.</p></div>
 </section>
 <Approach/>
 <section class="care care-green section-pad">
  <div class="care-image"><Image format="webp" src={imagery.care} widths={[400,700,1000]} sizes="(max-width:700px) 92vw,45vw" alt="ANZ gardener tending a living wall" loading="lazy"/><span class="care-sticker" aria-hidden="true" data-scroll-shape data-turn="-18"><NatureMark variant="sprout"/></span></div>
  <div class="care-copy"><span class="eyebrow">After planting</span><RevealHeading lines={["Keep your garden","growing."]} variant="soft"/><p>Pruning, plant health and seasonal maintenance for existing gardens.</p><Button href="/services/garden-maintenance/">Garden maintenance</Button></div>
 </section>
 <ProjectPreparation/>
 <Enquiry closing/>
</Layout>
<style>
 .project-comparison{margin-top:90px;padding-top:65px;border-top:1px solid var(--line);scroll-margin-top:25px}
 .project-comparison .section-heading{margin-bottom:35px}
 .project-comparison h2{font-size:clamp(36px,3.5vw,54px)}
 .comparison-caption{font-size:11px;color:var(--muted);margin-top:5px}
 @media(max-width:700px){.project-comparison{margin-top:55px;padding-top:40px}.project-comparison .section-heading{gap:20px;margin-bottom:25px}.project-comparison .text-link{font-size:12px}.comparison-caption{font-size:10px;max-width:250px}}
</style>
