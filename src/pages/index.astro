---
import { Picture, Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Arrow from '../components/Arrow.astro';
import Enquiry from '../components/Enquiry.astro';
import ProjectGallery from '../components/islands/ProjectGallery';
import ServiceExplorer from '../components/islands/ServiceExplorer';
import Process from '../components/islands/Process';
import { imagery, projects, services, processSteps, faqs } from '../data/content';
import type { ImageMetadata } from 'astro';
async function photo(image: ImageMetadata, alt: string) {
 const widths = [400, 700, Math.min(1100, image.width)].filter((v,i,a)=>a.indexOf(v)===i && v<=image.width);
 const images = await Promise.all(widths.map(width=>getImage({ src:image, width, format:'webp', quality:82 })));
 return { src:images[images.length-1].src, srcSet:images.map((v,i)=>`${v.src} ${widths[i]}w`).join(', '), width:image.width, height:image.height, alt };
}
const gallery = await Promise.all(projects.map(async p=>({...p,photo:await photo(p.image,`${p.name} — ANZ Landscaping project in ${p.location}`)})));
const serviceData = await Promise.all(services.map(async s=>({...s,photo:await photo(s.image,s.title)})));
const steps = await Promise.all(processSteps.map(async s=>({...s,photo:await photo(s.image,s.title)})));
const statement='We bring nature into the places you live and work. From the first idea to the final planting — and the care that follows.';
---
<Layout>
 <section class="hero" aria-labelledby="hero-title"><div class="hero-photo"><Picture fallbackFormat="webp" src={imagery.terrace} formats={['avif','webp']} widths={[480,800,1200,1600]} sizes="100vw" alt="A lush outdoor terrace with timber decking, a pergola and relaxed seating — ANZ Landscaping" loading="eager" fetchpriority="high" quality={60} /></div><div class="hero-shade"></div><div class="hero-card"><span class="eyebrow"><span class="status-dot"></span> Landscape design · Build · Care</span><h1 id="hero-title">A little closer<br />to nature.</h1><p>Thoughtful landscapes for the way you live.<br class="desktop-break" /> And the places you work.</p><Button href="#projects">Discover our work</Button><a class="hero-secondary" href="#enquire">Let’s create your space <span>↗</span></a></div><div class="hero-caption"><span>Good spaces.<br />Naturally.</span><a href="#about" aria-label="Discover ANZ Landscaping"><Arrow /></a></div><span class="hero-photo-credit">Outdoor living, by ANZ.</span></section>
 <section class="trust-strip" aria-label="Selected ANZ clients"><span>In good company.<br /><strong>Trusted by leading businesses.</strong></span><div class="client-logos"><img src="/images/anzc1.webp" alt="Brigade Group" width="130" height="65" loading="lazy" /><img src="/images/anzc6.webp" alt="BHIVE Workspace" width="110" height="65" loading="lazy" /><img src="/images/anzc7.webp" alt="Bosch" width="125" height="65" loading="lazy" /><img src="/images/anzc5.webp" alt="Prestige Group" width="120" height="65" loading="lazy" /><img src="/images/anzc10.webp" alt="Courtyard by Marriott" width="135" height="65" loading="lazy" /></div></section>
 <section id="about" class="intro section-pad"><div class="intro-label"><span class="eyebrow">Rooted in nature. Built around you.</span><span class="tiny-leaf" aria-hidden="true">✳</span></div><div class="intro-body"><h2 class="highlight-text" data-highlight aria-label={statement}>{statement.split(' ').map(word=><span class="word" aria-hidden="true">{[...word].map(character=><span class="char">{character}</span>)}{' '}</span>)}</h2><div class="intro-foot"><p>We’re ANZ Landscaping. A Bengaluru-based team bringing together landscape design, on-site execution and ongoing care for homes and businesses.</p><a class="text-link" href="#process">Get to know our approach <span>↗</span></a></div></div></section>
 <section id="projects" class="projects section-pad"><div class="section-heading"><div><span class="eyebrow">Selected projects</span><h2 data-blur>Real places.<br />Remarkable possibilities.</h2></div><p>Different spaces. One thoughtful approach.<br />Take a closer look at our work.</p></div><ProjectGallery projects={gallery} client:visible /></section>
 <section id="services" class="services section-pad"><div class="section-heading"><div><span class="eyebrow">What we do</span><h2>From a fresh idea<br />to a flourishing space.</h2></div><p>Design, execution and care.<br />All the pieces of a living landscape.</p></div><ServiceExplorer services={serviceData} client:visible /></section>
 <section class="living-banner"><div class="living-photo" data-parallax><Picture fallbackFormat="webp" src={imagery.malhar} formats={['webp']} widths={[480,811]} sizes="100vw" alt="Timber deck and planting at ANZ’s GoodEarth Malhar project" loading="lazy" /></div><div class="living-overlay"></div><div class="living-copy"><span class="eyebrow">More than a landscape</span><h2>A place to pause.<br />Room to come alive.</h2><Button href="#enquire" light>Make room for nature</Button></div><span class="living-location">GoodEarth Malhar · Bengaluru</span></section>
 <section id="process" class="process section-pad"><div class="section-heading"><div><span class="eyebrow">The ANZ approach</span><h2>Great landscapes.<br />Grounded in the details.</h2></div><p>A clear path from your first idea<br />to a space that feels like you.</p></div><Process steps={steps} client:visible /></section>
 <section class="care section-pad"><div class="care-image"><Image format="webp" src={imagery.care} widths={[400,700,1000]} sizes="(max-width: 700px) 92vw, 45vw" alt="ANZ team member carefully tending a vertical garden" loading="lazy" /><span class="care-sticker">A little care.<br />A lot of life.<span aria-hidden="true">✳</span></span></div><div class="care-copy"><span class="eyebrow">Built beautifully. Cared for thoughtfully.</span><h2>Our work grows<br />with your space.</h2><p>A landscape is a living thing. We look beyond the day it’s planted, with garden maintenance and plant care to help it settle in and thrive.</p><ul class="care-points"><li><span>01</span> A team that understands your landscape</li><li><span>02</span> Practical care, season after season</li><li><span>03</span> Attention in every detail</li></ul><Button href="/services/garden-maintenance/">Explore landscape care</Button></div></section>
 <section id="questions" class="faq section-pad"><div class="faq-heading"><span class="eyebrow">A little clarity</span><h2>Good questions.<br />Thoughtful answers.</h2><p>Still have something on your mind?<br />We’re always happy to talk.</p><a class="text-link" href="tel:+919845292729">Speak with our team <span>↗</span></a></div><div class="faq-list">{faqs.map((item,index)=><details name="faq" open={index===0}><summary>{item.question}<span class="faq-plus" aria-hidden="true"></span></summary><p>{item.answer}</p></details>)}</div></section>
 <Enquiry />
</Layout>
