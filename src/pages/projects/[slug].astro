---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import Enquiry from '../../components/Enquiry.astro';
import { projects } from '../../data/content';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project }=Astro.props;
const next = projects[(projects.findIndex(p=>p.slug===project.slug)+1)%projects.length];
---
<Layout title={`${project.name}, ANZ Landscaping`} description={project.description}>
 <section class="detail-heading section-pad"><a class="text-link" href="/#projects">← Back to our work</a><div class="section-heading"><div><span class="eyebrow">{project.category} · {project.location}</span><h1>{project.name}</h1></div><p>{project.description}</p></div></section>
 <div class="detail-gallery">{project.gallery.map((image,i)=><Picture fallbackFormat="webp" src={image} formats={['webp']} widths={[480,800,Math.min(1800,image.width)]} quality={i===0?90:84} sizes="(max-width: 700px) 100vw, 90vw" alt={`${project.name} landscape, ${i===0?'enhanced architectural view':`original project photograph ${i}`}`} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} />)}</div>
 <div class="detail-next section-pad"><span class="eyebrow">Keep exploring</span><h2>{next.name}</h2><Button href={`/projects/${next.slug}/`}>Next project</Button><a class="text-link" href={`https://anzlandscaping.in/projects/${project.slug}/`} target="_blank" rel="noopener noreferrer">View original project record ↗</a></div><Enquiry />
</Layout>
