---
import NatureMark from './NatureMark.astro';
import RevealHeading from './RevealHeading.astro';
const steps=[
 {title:'Plan',body:'A site visit, a clear brief and a design for your space.',shape:'seed' as const},
 {title:'Build',body:'Planting, materials and installation handled by our team.',shape:'leaf' as const},
 {title:'Care',body:'Regular maintenance to keep your garden healthy.',shape:'sprout' as const},
];
---
<section id="process" class="approach approach-reframed section-pad"><div class="approach-heading"><span class="eyebrow">How we work</span><RevealHeading lines={["One team.","From plan to care."]}/><a class="text-link" href="#enquire">Discuss your project</a></div><div class="approach-steps">{steps.map((step,index)=><article><div class="approach-symbol" data-scroll-shape data-turn={index===1?28:index===2?-12:0} data-grow={index===2?'true':undefined}><NatureMark variant={step.shape}/></div><div class="approach-step-title"><h3>{step.title}</h3></div><p>{step.body}</p></article>)}</div></section>
