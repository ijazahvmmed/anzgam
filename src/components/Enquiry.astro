---
import Arrow from './Arrow.astro';
---
<section id="enquire" class="enquiry section-pad"><div class="enquiry-heading"><span class="eyebrow">Something good starts here</span><h2 data-blur>Have a space<br />in mind?</h2><p>A garden, a workplace, a new possibility.<br />Tell us about it. We’ll take it from there.</p><a class="contact-phone" href="tel:+919845292729">+91 98452 92729 <span>↗</span></a><a href="mailto:contact@anzlandscaping.in">contact@anzlandscaping.in</a><span class="enquiry-location"><span class="status-dot"></span> Rooted in Bengaluru. Ready to grow.</span></div>
 <form class="enquiry-form" action="/api/enquiry" method="POST" data-enquiry>
  <div class="form-grid"><div class="field"><label for="name">Your name <span>*</span></label><input id="name" name="name" autocomplete="name" placeholder="How should we call you?" required maxlength="100" /></div><div class="field"><label for="email">Email address <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="200" /></div><div class="field"><label for="phone">Phone number <span>*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+91" required minlength="10" maxlength="25" pattern="[+0-9 ()\-]{10,25}" /></div><div class="field"><label for="location">Project location <span>*</span></label><input id="location" name="location" autocomplete="address-level2" placeholder="City / neighbourhood" required maxlength="150" /></div><div class="field"><label for="service">What can we help with? <span>*</span></label><select id="service" name="service" required><option value="">Select a service</option><option>Commercial landscaping</option><option>Residential garden</option><option>Terrace garden</option><option>Plantscaping & living walls</option><option>Garden maintenance</option><option>Office plant rental</option><option>Other services</option></select></div><div class="field"><label for="budget">Your estimated budget</label><select id="budget" name="budget"><option value="">Let’s discuss</option><option>₹1–5 lakh</option><option>₹5–10 lakh</option><option>₹10–25 lakh</option><option>₹25–50 lakh</option><option>₹50 lakh and above</option></select></div><div class="field field-full"><label for="message">A little about your space</label><textarea id="message" name="message" rows="3" placeholder="Your ideas, the size of your space, or anything else we should know…" maxlength="3000"></textarea></div></div>
  <div class="form-trap" aria-hidden="true"><label for="website">Leave this blank</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  <label class="consent"><input type="checkbox" name="consent" required /> <span>I agree to be contacted about my enquiry. <a href="https://anzlandscaping.in/privacy-policy/">Privacy policy</a></span></label>
  <div class="form-bottom"><p>Every great landscape begins<br />with a conversation.</p><button class="button" type="submit"><span class="button-label">Let’s bring it to life</span><span class="button-icon"><Arrow /></span></button></div><p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
 </form>
</section>
<script>
 const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
 form?.addEventListener('submit', async event => {
  event.preventDefault();
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const status = form.querySelector<HTMLElement>('.form-status')!;
  const label = button.querySelector<HTMLElement>('.button-label')!;
  button.disabled = true; label.textContent = 'Sending your enquiry…'; status.textContent = '';
  try {
   const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
   const result = await response.json();
   if(!response.ok || !result.success) throw new Error(result.message || 'We couldn’t send your enquiry. Please try again, or call +91 98452 92729.');
   status.textContent = 'Thank you. Your enquiry has been received. Keep this reference: ' + result.reference + '.'; status.dataset.state='success'; form.reset();
  } catch(error) { status.textContent = error instanceof Error ? error.message : 'Unable to send. Please email contact@anzlandscaping.in.'; status.dataset.state='error'; }
  finally { button.disabled=false;label.textContent='Let’s bring it to life'; status.focus(); }
 });
</script>
