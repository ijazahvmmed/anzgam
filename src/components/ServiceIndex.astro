---
import ServiceIcon from './ServiceIcon.astro';
import { allServices, serviceMenuGroups } from '../data/services';
interface Props { compact?: boolean; }
const {compact=false}=Astro.props;
---
<div class="home-service-index" aria-labelledby="service-index-title">
 {compact&&<h3 id="service-index-title" class="sr-only">All ANZ services</h3>}
 {!compact&&<div class="service-index-heading">
  <div><span class="eyebrow">Services</span><h3 id="service-index-title">All ANZ services</h3></div>
  <a class="text-link" href="/services/">All {allServices.length} services</a>
 </div>}
 <div class="service-index-groups">
  {serviceMenuGroups.map(group=><div class="service-index-group"><h4>{group.title}</h4><ul>{group.services.map(service=><li><a href={`/services/${service.slug}/`}><span class="service-index-icon"><ServiceIcon name={service.icon} size={21}/></span><span>{service.title}</span></a></li>)}</ul></div>)}
 </div>
</div>
