---
import '../styles/global.css';
import '../styles/services.css';
import 'lenis/dist/lenis.css';
import '../styles/refinements.css';
import '../styles/buttons.css';
import '../styles/navigation.css';
import '../styles/identity.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; }
const { title='ANZ Landscaping | Landscape design in Bengaluru', description='Landscape design, installation and garden care for homes and businesses in Bengaluru. Explore ANZ’s projects and services.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const business = { '@context':'https://schema.org', '@type':'LandscapingBusiness', name:'ANZ Landscaping', url:Astro.site?.toString(), telephone:'+919845292729', email:'contact@anzlandscaping.in', address:{'@type':'PostalAddress',streetAddress:'2948, 6th Cross Road, HAL 2nd Stage, Doopanahalli, Indiranagar',addressLocality:'Bengaluru',addressRegion:'Karnataka',postalCode:'560008',addressCountry:'IN'} };
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#163e2d" /><script is:inline>
 if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !location.hash) {
   document.documentElement.dataset.motionPending = '';
   setTimeout(() => { delete document.documentElement.dataset.motionPending; }, 1800);
 }
</script><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin /><link rel="preload" href="/fonts/satoshi-500.woff2" as="font" type="font/woff2" crossorigin /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL('/images/social.jpg', Astro.site)} /><meta name="twitter:card" content="summary_large_image" /><script type="application/ld+json" set:html={JSON.stringify(business)} /></head><body><a class="skip-link" href="#main">Skip to content</a><div id="top"></div><Header /><main id="main"><slot /></main><Footer /><script>
 import '../scripts/marquees';
 const loadMotion = () => Promise.all([import('../scripts/animations'), import('../scripts/smooth-scroll')]).catch(() => { delete document.documentElement.dataset.motionPending; });
 void document.fonts.ready.then(loadMotion);
 </script></body></html>
